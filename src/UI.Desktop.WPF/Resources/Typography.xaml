<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

  <Style BasedOn="{StaticResource {x:Type Window}}" TargetType="{x:Type Window}">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
  </Style>
</ResourceDictionary>
